# Servidor HTTP local.
PORT=3000

# Ambiente de execução: development ou production.
NODE_ENV=development

# Porta publicada pelo docker-compose no host.
KMZ_HOST_PORT=3008

# Cadeia de provedores em ordem de tentativa.
# Pode ser sobrescrita em runtime por dados/config.json via GET/POST /api/config.
GEOCODER_CHAIN=cnefe,google,nominatim,photon,bigdatacloud

# Modo legado: google ou mock. Mock só deve ser usado em revisão/teste.
GEOCODER_MODE=google

# Permite mock explicitamente quando true.
ALLOW_MOCK_GEOCODER=false

# Chave pública do Maps JavaScript API. Ela não é embutida no bundle; até a
# migração para GET /api/config, informe-a pela tela de configurações do app.
# Restrinja esta chave por API (somente Maps JavaScript API) e por origem quando
# houver uma origem HTTPS estável. Nunca reutilize GOOGLE_MAPS_SERVER_KEY aqui.
GOOGLE_MAPS_BROWSER_KEY=

# Map ID opcional para renderização Google Maps. Não é segredo, mas também não
# deve compartilhar a chave server-side.
GOOGLE_MAPS_MAP_ID=

# Chave server-side para Google Geocoding API. Injetar somente em runtime
# (por exemplo, environment do compose); não expor no browser nem usar ARG.
# Em runtime, fica mascarada em GET /api/config; POST /api/config aceita "__KEEP__".
GOOGLE_MAPS_SERVER_KEY=

# Email usado no User-Agent do Nominatim público.
NOMINATIM_EMAIL=

# Chave LocationIQ para reverse geocoding.
# Em runtime, fica mascarada em GET /api/config; string vazia limpa a chave.
LOCATIONIQ_API_KEY=

# Chave Geoapify para reverse geocoding.
# Em runtime, fica mascarada em GET /api/config; string vazia limpa a chave.
GEOAPIFY_API_KEY=

# Diretório dos CSVs CNEFE descompactados.
CNEFE_DIR=./dados/cnefe

# Limite máximo de linhas CNEFE indexadas no boot.
CNEFE_MAX_ROWS=3000000

# Valida CEP/logradouro/município/UF via ViaCEP quando true.
VIACEP_VALIDATION=false

# Faz conferência com o próximo provedor da cadeia quando true.
GEOCODE_CROSSCHECK=false

# Distância padrão de amostragem dos trechos quando o request não informar stepMeters.
GEOCODE_STEP_METERS=100

# Diretório do cache persistente de geocodificação.
# Também armazena config.json e sessoes/ do backend.
GEOCODE_CACHE_DIR=./dados

# Quantidade máxima de entradas no cache persistente.
GEOCODE_CACHE_MAX_ITEMS=50000
