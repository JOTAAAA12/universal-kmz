# Servidor HTTP local.
PORT=3000

# Ambiente de execução: development ou production.
NODE_ENV=development

# Porta publicada pelo docker-compose no host.
KMZ_HOST_PORT=3008

# Cadeia de provedores em ordem de tentativa.
GEOCODER_CHAIN=cnefe,google,nominatim,photon,bigdatacloud

# Modo legado: google ou mock. Mock só deve ser usado em revisão/teste.
GEOCODER_MODE=google

# Permite mock explicitamente quando true.
ALLOW_MOCK_GEOCODER=false

# Chave pública do Maps JavaScript API, usada apenas no navegador.
GOOGLE_MAPS_BROWSER_KEY=

# Map ID opcional para renderização Google Maps.
GOOGLE_MAPS_MAP_ID=

# Chave server-side para Google Geocoding API. Não expor no browser.
GOOGLE_MAPS_SERVER_KEY=

# Email usado no User-Agent do Nominatim público.
NOMINATIM_EMAIL=

# Chave LocationIQ para reverse geocoding.
LOCATIONIQ_API_KEY=

# Chave Geoapify para reverse geocoding.
GEOAPIFY_API_KEY=

# Diretório dos CSVs CNEFE descompactados.
CNEFE_DIR=./dados/cnefe

# Limite máximo de linhas CNEFE indexadas no boot.
CNEFE_MAX_ROWS=3000000

# Valida CEP/logradouro/município/UF via ViaCEP quando true.
VIACEP_VALIDATION=false

# Faz conferência com o próximo provedor da cadeia quando true.
GEOCODE_CROSSCHECK=false

# Diretório do cache persistente de geocodificação.
GEOCODE_CACHE_DIR=./dados

# Quantidade máxima de entradas no cache persistente.
GEOCODE_CACHE_MAX_ITEMS=50000
