{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:precision": "tsx scripts/precision-regression.ts",
    "test:providers": "tsx scripts/provider-chain-regression.ts",
    "test:cnefe": "tsx scripts/cnefe-regression.ts",
    "test:cnefedl": "tsx scripts/cnefe-downloader-regression.ts",
    "test:cache": "tsx scripts/cache-and-jobs-regression.ts",
    "test:trechos": "tsx scripts/trechos-regression.ts",
    "test:upload": "tsx scripts/upload-contract-regression.ts",
    "test:export": "tsx scripts/export-contract-regression.ts",
    "test:config": "tsx scripts/config-and-sessions-regression.ts",
    "test:pericial:parse": "tsx scripts/harness/pericial-parse-contract.ts",
    "test:pericial:export": "tsx scripts/harness/pericial-export-contract.ts",
    "test:pericial": "npm.cmd run test:pericial:parse && npm.cmd run test:pericial:export"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.9.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
