{
  "name": "universal-kmz",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Leitor de KML/KMZ com geocodificação de endereços (Google, OpenStreetMap, CNEFE/IBGE offline).",
  "author": "Universal KMZ",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron:dev": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/run-all-tests.ts",
    "test:precision": "tsx scripts/precision-regression.ts",
    "test:providers": "tsx scripts/provider-chain-regression.ts",
    "test:cnefe": "tsx scripts/cnefe-regression.ts",
    "test:ufbounds": "tsx scripts/uf-bounds-regression.ts",
    "test:cnefedl": "tsx scripts/cnefe-downloader-regression.ts",
    "test:cache": "tsx scripts/cache-and-jobs-regression.ts",
    "test:trechos": "tsx scripts/trechos-regression.ts",
    "test:upload": "tsx scripts/upload-contract-regression.ts",
    "test:export": "tsx scripts/export-contract-regression.ts",
    "test:config": "tsx scripts/config-and-sessions-regression.ts",
    "test:pericial:parse": "tsx scripts/harness/pericial-parse-contract.ts",
    "test:pericial:export": "tsx scripts/harness/pericial-export-contract.ts",
    "test:pericial:merge": "tsx scripts/pericial-merge-regression.ts",
    "test:pericial": "tsx scripts/harness/pericial-parse-contract.ts && tsx scripts/harness/pericial-export-contract.ts && tsx scripts/pericial-merge-regression.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.9.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.littlebull.universalkmz",
    "productName": "Universal KMZ",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "node_modules/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "src/data/municipios-ibge.json",
      "package.json",
      "node_modules/**",
      "!dados/**",
      "!release/**",
      "!dist_electron/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal KMZ"
    }
  }
}
